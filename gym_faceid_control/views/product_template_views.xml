<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_faceid" model="ir.ui.view">
        <field name="name">product.template.form.faceid</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Integración FaceID (Suscripción No Recurrente)">
                    <field name="faceid_access_duration_value"/>
                    <field name="faceid_access_duration_unit"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
