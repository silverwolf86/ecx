<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_account_payment_bank_txt" model="ir.actions.report">
        <field name="name">Archivo Banco (TXT)</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">hfit_payroll_ecuador.report_account_payment_bank_txt</field>
        <field name="report_file">hfit_payroll_ecuador.report_account_payment_bank_txt</field>
        <field name="print_report_name">'pago_banco_%s' % (object.memo or object.name)</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_account_payment_bank_txt"><t t-out="docs._get_bank_txt()"/></template>
</odoo>
