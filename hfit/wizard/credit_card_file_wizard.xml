<odoo>
  <record id="view_upload_returned_excel_wizard_form" model="ir.ui.view">
    <field name="name">hfit.upload.returned.excel.form</field>
    <field name="model">hfit.upload.returned.excel</field>
    <field name="arch" type="xml">
      <form string="Cargar devueltos (Excel)">
        <group>         
          <field name="file" filename="filename"/>
          <field name="filename"/>
        </group>
        <footer>
          <button string="Procesar" type="object" name="action_process_file" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_upload_returned_excel_wizard" model="ir.actions.act_window">
    <field name="name">Cargar Devueltos</field>
    <field name="res_model">hfit.upload.returned.excel</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>