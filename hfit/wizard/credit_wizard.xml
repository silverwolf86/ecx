<odoo>
  <record id="view_account_move_export_wizard" model="ir.ui.view">
    <field name="name">account.move.export.wizard.form</field>
    <field name="model">account.move.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Exportar facturas a TXT">
        <group>
          <field name="generation_date" />
          <field name="cc_group_id" />
          <field name="cc_brand_id" />
          <field name="sequence_header" />
          <field name="sequence_detail" />
          <field name="file_data" />
        </group>
        <footer>
          <button string="Generar" class="btn-primary" name="export_txt_file" type="object" />
          <button string="Cerrar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
