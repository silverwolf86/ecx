<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="credit_card_file_so_view_form" model="ir.ui.view">
        <field name="name">credit.card.file.view.form</field>
        <field name="model">credit.card.file.so</field>
        <field name="arch" type="xml">
            <form string="">                
                <xpath expr="//header" position="inside">
                    <button name="generate_file" type="object" string="Generar" class="btn-primary" />
                    <button name="action_open_invoices"
                        type="object" string="Ver facturas" class="btn-secondary" />
                    <button name="%(action_upload_returned_excel_wizard)d" type="action"
                        string="Cargar Devueltos" class="btn-secondary" />
                    <button name="cancel_file" type="object"
                        string="Cancelar Envio" class="btn-danger" />
                </xpath>
                <sheet>
                    <group>
                        <!-- Add your fields here -->
                        <field name="cc_brand_ids" widget="many2many_tags" />
                        <field name="cc_branch_id" />
                        <field name="sequence_header" />
                        <field name="sequence_detail" />
                    </group>
                    <group>
                        <!-- Add your fields here -->
                        <field name="cc_group_id" />
                        <field name="generation_date" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- credit.card.file tree view -->
    <record id="credit_card_file_so_view_tree" model="ir.ui.view">
        <field name="name">credit.card.file.view.tree</field>
        <field name="model">credit.card.file.so</field>
        <field name="arch" type="xml">
            <list>
                <!-- Add your fields here -->
                <field name="generation_date" />
                <field name="cc_group_id" />
            </list>
        </field>
    </record>

    <!-- credit.card.brand action window -->
    <record id="credit_card_file_so_action" model="ir.actions.act_window">
        <field name="name">credit.card.file.action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">credit.card.file.so</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                <!-- Add Text Here -->
            </p>
            <p>
                <!-- More details about what a user can do with this object will be OK -->
            </p>
        </field>
    </record>

    <!-- This Menu Item must have a parent and an action -->
    <menuitem id="menu_credit_card_file_so"
        name="Archivos Tarjetas Subscripciones"
        parent="contacts.res_partner_menu_contacts"
        action="credit_card_file_so_action" sequence="100" />

</odoo>