<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Menu for Branches under Settings > Users -->
    <menuitem id="menu_res_branch_root" name="Branches" parent="base.menu_users" sequence="100" />
 
    <!-- Action for Branch List -->
    <record id="action_res_branch_tree" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">res.branch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first branch
            </p>
        </field>
    </record>

    <!-- Tree View for Branches -->
    <record id="view_res_branch_tree" model="ir.ui.view">
        <field name="name">res.branch.tree</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="name" />
                <field name="code" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Form View for Branches -->
    <record id="view_res_branch_form" model="ir.ui.view">
        <field name="name">res.branch.form</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <group>
                        <group name="general" string="General">
                            <field name="name" />
                            <field name="code" />
                            <field name="active" />
                            <field name="collect_datacard_code" />
                        </group>
                        <group name="virtuagym" string="Virtuagym">
                            <field name="virtuagym_club_id" />
                            <field name="virtuagym_club_secret" password="True" />
                            <field name="virtuagym_api_key" password="True" />
                            <field name="virtuagym_salesperson_id" />
                        </group>
                        <group name="faceid" string="FaceID (ISAPI)">
                            <field name="face_id_url" placeholder="https://bridge.midominio.com" />
                            <field name="face_id_user" />
                            <field name="face_id_password" password="True" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_res_branch" name="Manage Branches" parent="menu_res_branch_root"
        action="action_res_branch_tree" sequence="10" />

</odoo>