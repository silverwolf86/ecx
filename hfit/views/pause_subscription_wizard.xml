<odoo>
  <record id="view_pause_subscription_wizard_form" model="ir.ui.view">
    <field name="name">hfit.pause.subscription.wizard.form</field>
    <field name="model">hfit.pause.subscription.wizard</field>
    <field name="arch" type="xml">
      <form string="Pausar suscripción">
        <group>
          <field name="sale_order_id" invisible="1"/>
          <field name="start_date"/>
          <field name="end_date"/>
        </group>
        <footer>
          <button string="Confirmar" type="object" name="action_confirm_pause"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>