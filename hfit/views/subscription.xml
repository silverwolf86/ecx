<odoo>

  <!-- Vista de lista (tree) -->
    <record id="view_subscription_group_tree" model="ir.ui.view">
        <field name="name">subscription.group.tree</field>
        <field name="model">subscription.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario (form) -->
    <record id="view_subscription_group_form" model="ir.ui.view">
        <field name="name">subscription.group.form</field>
        <field name="model">subscription.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Definir la acción para abrir el formulario -->
    <record id="action_subscription_group" model="ir.actions.act_window">
        <field name="name">Subscription Groups</field>
        <field name="res_model">subscription.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Agregar un menú para acceder a la acción -->
    <menuitem id="menu_subscription_group_root" name="Subscription Groups"/>
    <menuitem id="menu_subscription_group" name="Subscription Groups" parent="menu_subscription_group_root" action="action_subscription_group"/>

  
</odoo>