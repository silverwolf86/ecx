<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_template_form_virtuagym" model="ir.ui.view">
        <field name="name">product.template.form.virtuagym</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='upsell']" position="after">
                <group string="Virtuagym" name="virtuagym">
                    <field name="virtuagym_membership_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
