<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="eh_account_dynamic_reports.DynamicReportViewer">
    <div class="eh_dr o_action">
        <div class="eh_dr_topbar">
            <div class="eh_dr_titlebar">
                <div class="eh_dr_title_block">
                    <h2 class="eh_dr_title">
                        <t t-out="state.reportName"/>
                    </h2>
                    <div class="eh_dr_subtitle" t-if="state.payload">
                        <span class="eh_dr_currency_badge"
                              t-att-class="state.payload.currency.multi_currency ? 'eh_dr_currency_badge--multi' : ''">
                            <t t-if="state.payload.currency.multi_currency">
                                Multi-currency
                            </t>
                            <t t-else="">
                                <t t-out="state.payload.currency.name"/>
                                <t t-if="state.payload.currency.symbol">
                                    (<t t-out="state.payload.currency.symbol"/>)
                                </t>
                            </t>
                        </span>
                        <span class="eh_dr_period_badge" t-if="state.payload.meta">
                            <i class="fa fa-calendar me-1"/>
                            <t t-out="state.payload.meta.date_from"/>
                            <span class="mx-1">to</span>
                            <t t-out="state.payload.meta.date_to"/>
                        </span>
                    </div>
                </div>
                <div class="eh_dr_actions">
                    <select class="eh_dr_saved_view_select"
                            t-if="state.savedViews.length"
                            t-on-change="onSavedViewChange"
                            t-att-value="state.currentSavedViewId || ''">
                        <option value="">Saved views...</option>
                        <t t-foreach="state.savedViews" t-as="v"
                           t-key="v.id">
                            <option t-att-value="v.id"
                                    t-att-selected="state.currentSavedViewId === v.id">
                                <t t-out="v.name"/>
                                <t t-if="v.shared">·shared</t>
                            </option>
                        </t>
                    </select>
                    <button class="btn btn-link eh_dr_collapse_toggle"
                            t-on-click="onToggleFilters">
                        <i t-att-class="state.filtersExpanded ? 'fa fa-chevron-up' : 'fa fa-sliders'"/>
                        <span class="ms-1">
                            <t t-if="state.filtersExpanded">Hide filters</t>
                            <t t-else="">More filters</t>
                            <t t-if="activeFilterCount() and !state.filtersExpanded">
                                · <span class="eh_dr_filter_count">
                                    <t t-out="activeFilterCount()"/>
                                </span>
                            </t>
                        </span>
                    </button>
                    <button class="btn btn-secondary"
                            t-on-click="onRefresh"
                            t-att-disabled="state.loading">
                        <i class="fa fa-refresh me-1"/>
                        Refresh
                    </button>
                    <button class="btn btn-secondary"
                            t-on-click="onPrintPdf"
                            t-att-disabled="state.loading">
                        <i class="fa fa-file-pdf-o me-1"/>
                        Print PDF
                    </button>
                    <button class="btn btn-primary"
                            t-on-click="onExportXlsx"
                            t-att-disabled="state.loading">
                        <i class="fa fa-file-excel-o me-1"/>
                        Export to Excel
                    </button>
                </div>
            </div>
            <div class="eh_dr_filters">
                <label class="eh_dr_filter">
                    <span>Date mode</span>
                    <select t-on-change="onDateModeChange"
                            t-att-value="state.options.date.mode">
                        <option value="range" t-att-selected="state.options.date.mode === 'range'">Range</option>
                        <option value="as_of" t-att-selected="state.options.date.mode === 'as_of'">As of</option>
                        <option value="this_month" t-att-selected="state.options.date.mode === 'this_month'">This month</option>
                        <option value="this_quarter" t-att-selected="state.options.date.mode === 'this_quarter'">This quarter</option>
                        <option value="this_year" t-att-selected="state.options.date.mode === 'this_year'">This year</option>
                        <option value="last_month" t-att-selected="state.options.date.mode === 'last_month'">Last month</option>
                        <option value="last_quarter" t-att-selected="state.options.date.mode === 'last_quarter'">Last quarter</option>
                        <option value="last_year" t-att-selected="state.options.date.mode === 'last_year'">Last year</option>
                    </select>
                </label>
                <label class="eh_dr_filter"
                       t-if="state.options.date.mode !== 'as_of'">
                    <span>Date From</span>
                    <input type="date"
                           t-att-value="state.options.date.date_from"
                           t-on-change="onDateFromChange"/>
                </label>
                <label class="eh_dr_filter">
                    <span>
                        <t t-if="state.options.date.mode === 'as_of'">As of</t>
                        <t t-else="">Date To</t>
                    </span>
                    <input type="date"
                           t-att-value="state.options.date.date_to"
                           t-on-change="onDateToChange"/>
                </label>
                <label class="eh_dr_filter">
                    <span>Compare</span>
                    <select t-on-change="onComparisonChange"
                            t-att-value="state.options.comparison || 'none'">
                        <option value="none">No comparison</option>
                        <option value="previous_period">Previous period</option>
                        <option value="previous_year">Same period last year</option>
                    </select>
                </label>
                <label class="eh_dr_filter eh_dr_check">
                    <input type="checkbox"
                           t-att-checked="state.options.posted_only"
                           t-on-change="onPostedOnlyToggle"/>
                    <span>Posted entries only</span>
                </label>
                <label class="eh_dr_filter eh_dr_check">
                    <input type="checkbox"
                           t-att-checked="state.options.show_zero"
                           t-on-change="onShowZeroToggle"/>
                    <span>Show zero balance accounts</span>
                </label>
            </div>
            <div class="eh_dr_filters_advanced" t-if="state.filtersExpanded">
                <div class="eh_dr_filter_group">
                    <label class="eh_dr_filter eh_dr_filter_wide">
                        <span>Companies</span>
                        <select multiple="multiple" size="3"
                                t-on-change="(e) => this.onMultiSelectChange(e, 'company_ids')">
                            <t t-foreach="state.choices.companies" t-as="c"
                               t-key="c.id">
                                <option t-att-value="c.id"
                                        t-att-selected="state.options.company_ids.includes(c.id)">
                                    <t t-out="c.name"/>
                                </option>
                            </t>
                        </select>
                    </label>
                    <label class="eh_dr_filter eh_dr_filter_wide">
                        <span>Journals</span>
                        <select multiple="multiple" size="3"
                                t-on-change="(e) => this.onMultiSelectChange(e, 'journal_ids')">
                            <t t-foreach="state.choices.journals" t-as="j"
                               t-key="j.id">
                                <option t-att-value="j.id"
                                        t-att-selected="state.options.journal_ids.includes(j.id)">
                                    <t t-out="j.name"/>
                                </option>
                            </t>
                        </select>
                    </label>
                    <label class="eh_dr_filter eh_dr_filter_wide">
                        <span>Account types</span>
                        <select multiple="multiple" size="3"
                                t-on-change="(e) => this.onMultiSelectChangeStr(e, 'account_type_ids')">
                            <t t-foreach="state.choices.accountTypes" t-as="t"
                               t-key="t.code">
                                <option t-att-value="t.code"
                                        t-att-selected="(state.options.account_type_ids || []).includes(t.code)">
                                    <t t-out="t.label"/>
                                </option>
                            </t>
                        </select>
                    </label>
                </div>
                <div class="eh_dr_filter_group">
                    <label class="eh_dr_filter eh_dr_filter_wide">
                        <span>Partners</span>
                        <select multiple="multiple" size="3"
                                t-on-change="(e) => this.onMultiSelectChange(e, 'partner_ids')">
                            <t t-foreach="state.choices.partners" t-as="p"
                               t-key="p.id">
                                <option t-att-value="p.id"
                                        t-att-selected="state.options.partner_ids.includes(p.id)">
                                    <t t-out="p.name"/>
                                </option>
                            </t>
                        </select>
                        <button class="btn btn-link p-0 mt-1 eh_dr_more_btn"
                                t-on-click="() => this.openManyToManyPicker('res.partner', 'partner_ids', 'Partners')">
                            <i class="fa fa-plus me-1"/>Pick more...
                        </button>
                    </label>
                    <label class="eh_dr_filter eh_dr_filter_wide">
                        <span>Accounts</span>
                        <input type="search" class="eh_dr_filter_search"
                               placeholder="Search code or name, e.g. 401005"
                               t-on-input="(e) => this.onAccountSearch(e)"/>
                        <select multiple="multiple" size="3"
                                t-on-change="(e) => this.onMultiSelectChange(e, 'account_ids')">
                            <t t-foreach="state.choices.accounts" t-as="a"
                               t-key="a.id">
                                <option t-att-value="a.id"
                                        t-att-selected="state.options.account_ids.includes(a.id)">
                                    <t t-out="a.code"/> <t t-out="a.name"/>
                                </option>
                            </t>
                        </select>
                        <button class="btn btn-link p-0 mt-1 eh_dr_more_btn"
                                t-on-click="() => this.openManyToManyPicker('account.account', 'account_ids', 'Accounts')">
                            <i class="fa fa-plus me-1"/>Pick more...
                        </button>
                    </label>
                </div>
                <div class="eh_dr_filter_group" t-if="state.choices.analyticPlans.length">
                    <label class="eh_dr_filter eh_dr_filter_wide">
                        <span>Analytic plans</span>
                        <select multiple="multiple" size="3"
                                t-on-change="(e) => this.onMultiSelectChange(e, 'analytic_plan_ids')">
                            <t t-foreach="state.choices.analyticPlans" t-as="p"
                               t-key="p.id">
                                <option t-att-value="p.id"
                                        t-att-selected="state.options.analytic_plan_ids.includes(p.id)">
                                    <t t-out="p.name"/>
                                </option>
                            </t>
                        </select>
                    </label>
                    <label class="eh_dr_filter eh_dr_filter_wide">
                        <span>Analytic accounts</span>
                        <select multiple="multiple" size="3"
                                t-on-change="(e) => this.onMultiSelectChange(e, 'analytic_account_ids')">
                            <t t-foreach="state.choices.analyticAccounts" t-as="a"
                               t-key="a.id">
                                <option t-att-value="a.id"
                                        t-att-selected="state.options.analytic_account_ids.includes(a.id)">
                                    <t t-out="a.name"/>
                                </option>
                            </t>
                        </select>
                        <button class="btn btn-link p-0 mt-1 eh_dr_more_btn"
                                t-on-click="() => this.openManyToManyPicker('account.analytic.account', 'analytic_account_ids', 'Analytic Accounts')">
                            <i class="fa fa-plus me-1"/>Pick more...
                        </button>
                    </label>
                </div>
                <div class="eh_dr_filter_actions">
                    <button class="btn btn-link p-0 me-3"
                            t-on-click="onClearAllFilters">
                        <i class="fa fa-times me-1"/>Clear all
                    </button>
                    <button class="btn btn-link p-0"
                            t-on-click="onSaveCurrentView">
                        <i class="fa fa-bookmark me-1"/>Save current view
                    </button>
                    <button class="btn btn-link p-0 ms-3 text-danger"
                            t-if="state.currentSavedViewId"
                            t-on-click="onDeleteSavedView">
                        <i class="fa fa-trash me-1"/>Delete view
                    </button>
                </div>
            </div>
            <div class="eh_dr_chips" t-if="activeChips().length">
                <span class="eh_dr_chips_label">Active filters:</span>
                <t t-foreach="activeChips()" t-as="chip" t-key="chip_index">
                    <span class="eh_dr_chip">
                        <t t-out="chip.label"/>
                        <button class="eh_dr_chip_x"
                                t-on-click="() => this.onRemoveChip(chip)">
                            ×
                        </button>
                    </span>
                </t>
            </div>
        </div>

        <div class="eh_dr_body">
            <t t-if="state.error">
                <div class="alert alert-danger m-3" role="alert">
                    <strong>Error:</strong>
                    <t t-out="state.error"/>
                </div>
            </t>
            <t t-elif="state.loading">
                <div class="eh_dr_loading">
                    <i class="fa fa-spinner fa-spin me-2"/>
                    Loading report...
                </div>
            </t>
            <t t-elif="state.payload">
                <div class="eh_dr_meta_bar">
                    <span class="eh_dr_meta" t-if="state.payload.from_cache">
                        <i class="fa fa-bolt me-1"/>
                        Served from cache (execution
                        <t t-out="state.payload.execution_id"/>)
                    </span>
                    <span class="eh_dr_meta">
                        <i class="fa fa-list-ol me-1"/>
                        <t t-out="state.payload.lines.length"/> rows
                    </span>
                    <button class="btn btn-link btn-sm p-0 ms-auto"
                            t-if="hasHierarchy()"
                            t-on-click="onCollapseAll">
                        <i class="fa fa-compress me-1"/>Collapse all
                    </button>
                    <button class="btn btn-link btn-sm p-0 ms-2"
                            t-if="hasHierarchy()"
                            t-on-click="onExpandAll">
                        <i class="fa fa-expand me-1"/>Expand all
                    </button>
                </div>
                <table class="eh_dr_table table table-sm">
                    <thead>
                        <tr>
                            <t t-foreach="state.payload.columns" t-as="col"
                               t-key="col_index">
                                <th t-att-class="['monetary', 'integer', 'float', 'percentage'].includes(col.figure_type) ? 'text-end' : ''">
                                    <t t-out="col.name"/>
                                    <small class="eh_dr_col_unit"
                                           t-if="col.figure_type === 'monetary'
                                               and state.payload.currency.symbol
                                               and !state.payload.currency.multi_currency">
                                        (<t t-out="state.payload.currency.symbol"/>)
                                    </small>
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="visibleLines()" t-as="line"
                           t-key="line_index + '-' + line.id">
                            <tr t-att-class="rowClass(line)"
                                t-on-click="() => this.onLineClick(line)">
                                <td t-att-style="nameStyle(line)"
                                    t-att-class="line.level === 0 ? 'fw-bold' : ''">
                                    <span class="eh_dr_unfold_caret"
                                          t-if="line.unfoldable"
                                          t-on-click.stop="() => this.onToggleLine(line)">
                                        <i t-att-class="isExpanded(line) ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                                    </span>
                                    <t t-out="line.name"/>
                                </td>
                                <t t-foreach="valueColumnDefs()" t-as="col"
                                   t-key="col_index">
                                    <td t-att-class="cellClass(line, col_index)">
                                        <t t-out="formatLineValue(line, col_index)"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                        <t t-if="!state.payload.lines.length">
                            <tr>
                                <td t-att-colspan="state.payload.columns.length"
                                    class="text-center text-muted py-4">
                                    No data for the selected filters.
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </div>

        <div class="eh_dr_brand_footer">
            Made with <span class="eh_dr_heart">🤍</span> from Melbourne by
            <strong>ERP Heritage</strong>
        </div>
    </div>
</t>

</templates>
