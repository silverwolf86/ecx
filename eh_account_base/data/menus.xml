<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ERP Heritage Suite: canonical Heritage menu skeleton.

    All EH accounting modules anchor their menus to the parent menus
    defined here. Submodules use parent="eh_account_base.menu_eh_..."
    instead of inventing their own root menus, so the navigation
    experience is consistent regardless of which subset of the suite a
    deployment installs.

    Hierarchy:

    Accounting (upstream account.menu_finance)
    +- Customers (upstream)              [collections, recurring, cheques in]
    +- Vendors (upstream)                [AP automation, cheques out]
    +- Accounting (upstream)
    |  +- Heritage Operations            [batch payments, SEPA, PDC, recon, BSI, approvals]
    |  +- Heritage Period Work           [close, FX, year-end, assets, budgets, BAS]
    +- Reporting (upstream)
    |  +- Heritage Advanced              [builder, saved views, schedules, forecasts]
    +- Configuration (upstream)
       +- Heritage                       [audit logs, policies, banking, payments, l10n]
          +- General
          +- Reports
          +- Operations
          +- Assets
          +- Banking
          +- Payments
          +- Cheques (PDC)
          +- Localization
          +- Audit Logs

    Group conventions:

    * eh_account_base.group_eh_user      day-to-day operator
    * eh_account_base.group_eh_manager   configuration and overrides
    * eh_account_base.group_eh_auditor   read-only on every audit log

    Sequence convention (Heritage subtree):

    * 30..39  Operations roots
    * 40..49  Period Work roots
    * 60..89  Configuration sections
    * 100..199 Reporting (Pro extras)
-->
<odoo>
    <data>

        <!-- ===== Heritage subtrees under Accounting > Accounting ===== -->

        <menuitem id="menu_eh_operations"
                  name="Heritage Operations"
                  parent="account.menu_finance_entries"
                  sequence="30"
                  groups="eh_account_base.group_eh_user"/>

        <menuitem id="menu_eh_period_work"
                  name="Heritage Period Work"
                  parent="account.menu_finance_entries"
                  sequence="32"
                  groups="eh_account_base.group_eh_user"/>

        <!-- ===== Heritage advanced reports under Reporting ===== -->

        <menuitem id="menu_eh_reports_advanced"
                  name="Heritage Advanced"
                  parent="account.menu_finance_reports"
                  sequence="100"
                  groups="eh_account_base.group_eh_user"/>

        <!-- ===== Heritage Configuration root and sub-sections ===== -->

        <menuitem id="menu_eh_config_root"
                  name="Heritage"
                  parent="account.menu_finance_configuration"
                  sequence="60"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_general"
                  name="General"
                  parent="menu_eh_config_root"
                  sequence="10"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_reports"
                  name="Reports"
                  parent="menu_eh_config_root"
                  sequence="20"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_operations"
                  name="Operations"
                  parent="menu_eh_config_root"
                  sequence="30"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_assets"
                  name="Assets and Leases"
                  parent="menu_eh_config_root"
                  sequence="40"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_banking"
                  name="Banking"
                  parent="menu_eh_config_root"
                  sequence="50"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_payments"
                  name="Payments and SEPA"
                  parent="menu_eh_config_root"
                  sequence="60"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_pdc"
                  name="Cheques (PDC)"
                  parent="menu_eh_config_root"
                  sequence="70"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_localization"
                  name="Localization"
                  parent="menu_eh_config_root"
                  sequence="80"
                  groups="eh_account_base.group_eh_manager"/>

        <menuitem id="menu_eh_config_audit"
                  name="Audit Logs"
                  parent="menu_eh_config_root"
                  sequence="90"
                  groups="eh_account_base.group_eh_auditor"/>

        <!-- ===== Always-on Heritage entries owned by base ===== -->

        <!-- Report execution audit log lives under Audit Logs. The
             action is declared in views/report_execution_views.xml
             alongside the form / list / search views. -->
        <menuitem id="menu_eh_audit_report_execution"
                  name="Report Execution Audit"
                  parent="menu_eh_config_audit"
                  action="action_eh_account_report_execution"
                  sequence="10"
                  groups="eh_account_base.group_eh_auditor"/>

    </data>
</odoo>
