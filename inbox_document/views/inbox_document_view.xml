    <record id="inbox_document_action" model="ir.actions.act_window">
        <field name="name">Documentos de Entrada</field>
        <field name="res_model">inbox.document</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="search_view_id" ref="inbox_document_view_search"/> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen registros para mostrar
            </p><p>
                Cargue un archivo de claves de acceso del SRI.
            </p>
        </field>
    </record>

    <record id="inbox_document_action_reprocess" model="ir.actions.server">
        <field name="name">Reprocesar XML</field>
        <field name="state">code</field>
        <field name="model_id" ref="inbox_document.model_inbox_document"/>
        <field name="binding_model_id" ref="inbox_document.model_inbox_document"/>
        <field name="code">
if records:
    records.reprocesar_xml()
        </field>
    </record>

    <record id="inbox_document_action_create_invoice" model="ir.actions.server">
        <field name="name">Crear documentos</field>
        <field name="state">code</field>
        <field name="model_id" ref="inbox_document.model_inbox_document"/>
        <field name="binding_model_id" ref="inbox_document.model_inbox_document"/>
        <field name="code">
if records:
    records.create_invoice()
        </field>
    </record>
</odoo>
