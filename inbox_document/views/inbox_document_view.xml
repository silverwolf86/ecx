<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="inbox_document_view_form" model="ir.ui.view">
        <field name="name">inbox.document.view.form</field>
        <field name="model">inbox.document</field>
        <field name="arch" type="xml">
            <form string="Documento de Entrada">
                <header>
                    <button name="reprocesar_xml" type="object" string="Reprocesar XML"
                            class="oe_highlight"/>
                    <button name="create_invoice" type="object" string="Crear Documento"
                            class="oe_highlight"
                            invisible="estado == 'procesado' or not line_ids"/>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="cargado,consultado,procesado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="numero_comprobante" placeholder="000-000-000000000"/></h1>
                    </div>
                    <group>
                        <group string="Comprobante">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tipo_documento"/>
                            <field name="clave_acceso"/>
                            <field name="numero_autorizacion"/>
                            <field name="fecha_autorizacion"/>
                            <field name="fecha_emision"/>
                        </group>
                        <group string="Emisor">
                            <field name="partner_id"/>
                            <field name="partner_name"/>
                            <field name="ruc_emisor"/>
                            <field name="total"/>
                            <field name="agrupar"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" optional="show"/>
                                    <field name="product_code" optional="show"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="discount_amount"/>
                                    <field name="discount" optional="hide"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Información Adicional" name="info_adicional">
                            <field name="info_adicional"/>
                        </page>
                        <page string="XML Recibido" name="xml">
                            <field name="xml_recibido"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="inbox_document_view_tree" model="ir.ui.view">
        <field name="name">inbox.document.view.list</field>
        <field name="model">inbox.document</field>
        <field name="arch" type="xml">
            <list
                string="Documentos de Entrada"
                js_class="inbox_document_list"
                decoration-info="estado == 'consultado'"
                decoration-success="estado == 'procesado'"
                decoration-danger="estado == 'error'">
                <field name="fecha_emision"/>
                <field name="numero_comprobante"/>
                <field name="tipo_documento"/>
                <field name="partner_id"/>
                <field name="ruc_emisor" optional="show"/>
                <field name="clave_acceso" optional="hide"/>
                <field name="numero_autorizacion" optional="hide"/>
                <field name="fecha_autorizacion" optional="hide"/>
                <field name="total" sum="Total"/>
                <field name="invoice_id" optional="show"/>
                <field name="estado" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
